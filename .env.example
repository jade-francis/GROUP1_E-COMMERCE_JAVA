DB_URL=jdbc:postgresql://localhost:5432/shopease_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
SHOPEASE_ADMIN_EMAIL=admin@example.com
SHOPEASE_ADMIN_PASSWORD=use_a_strong_password

# SMTP credentials used to deliver login verification codes
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM=your_email@gmail.com

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional local upload directory
SHOPEASE_UPLOAD_DIR=uploads/products

# Optional DigitalOcean Spaces configuration for persistent production uploads
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_PUBLIC_URL=
